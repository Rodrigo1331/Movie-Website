# Copy this file to `.env` (same folder) and fill in your values.
# `.env` is gitignored and is only read by the Node server — never by the browser.

# TMDB "API Read Access Token" (v4, starts with "eyJ...") — recommended.
# A v3 "API Key" also works. Get one at https://www.themoviedb.org/settings/api
# Leave empty to run without TMDB (manual movie entry still works).
TMDB_API_TOKEN=

# Optional
PORT=3001
HOST=127.0.0.1
# DATABASE_PATH=server/data/movies.db
